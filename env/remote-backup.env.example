# Copy to env/remote-backup.env to enable off-host backup sync.
# Space-separated rclone destinations. You may use one or multiple targets.
REMOTE_BACKUP_TARGETS="r2:your-r2-bucket/hermes cos:your-cos-bucket/hermes"

# Set true if backup scripts should sync automatically after creating local backups.
AUTO_REMOTE_BACKUP=false

# Keep remote objects forever by default. Set true only if you want remote mirror behavior.
REMOTE_BACKUP_SYNC_DELETE=false
