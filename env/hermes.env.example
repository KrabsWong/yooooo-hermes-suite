# Copy this file to data/hermes-home/.env and fill only what you use.

# --- LLM providers ---
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Web search / extraction backends (optional) ---
FIRECRAWL_API_KEY=
PARALLEL_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
SEARXNG_URL=

# --- Hermes API server (optional) ---
API_SERVER_ENABLED=false
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8642
API_SERVER_KEY=
API_SERVER_CORS_ORIGINS=http://127.0.0.1:8787

# --- Gateway access policy (optional) ---
GATEWAY_ALLOW_ALL_USERS=

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
